# =========================================================================================
# DATABASE CONNECTION ENVIRONMENT VARIABLES
# =========================================================================================
# IMPORTANT NOTE FOR RUNNING THIS APPLICATION ON YOUR MACHINE:
# Because Drizzle ORM and node-postgres resolve connection pools statistically at run time/
# module-loading time, your Node.js application may attempt to parse these variables BEFORE
# your local 'dotenv' library reads this file.
# 
# If you encounter authentication errors (e.g., "client password must be a string",
# "password authentication failed for user 'your-os-username'"), set these variables 
# globally on your operating system so Node.js can read them directly from process.env
# at launch:
# 
# Windows Powershell (no need for administrator mode):
# [System.Environment]::SetEnvironmentVariable('DB_HOST', localhost, 'User')
# [System.Environment]::SetEnvironmentVariable('DB_PORT', 5432, 'User')
# [System.Environment]::SetEnvironmentVariable('DB_NAME', coffee_brews, 'User')
# [System.Environment]::SetEnvironmentVariable('DB_USER', postgres, 'User')
# [System.Environment]::SetEnvironmentVariable('DB_PASSWORD', your_db_password, 'User')
#
# MacOS / Linux Terminal (~/.zshrc or ~/.bashrc):
# export DB_HOST=localhost
# export DB_PORT=5432
# export DB_NAME=coffee_brews
# export DB_USER=postgres
# export DB_PASSWORD=your_db_password
#
# Alternatively, you can navigate to your user environment variables on your monitor
# and add them directly there. 
#
# Either way, note that it might be necessary to restart your machine in order for 
# the newly added environment variables to reflect. Verify visibility with
# console.log(process.env).

DB_HOST=localhost
DB_PORT=5432
DB_NAME=coffee_brews
DB_USER=postgres
DB_PASSWORD=your_db_password
